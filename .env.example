# Copie este arquivo para .env e preencha os valores.

# Connection string do Postgres (Supabase: Project Settings > Database > Connection string).
# Em produção (Vercel), use a "Transaction pooler" (porta 6543, com ?pgbouncer=true).
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Necessária só em produção (Vercel): connection string "Direct connection" (porta 5432),
# usada exclusivamente para rodar as migrations (prisma migrate deploy).
# Localmente pode deixar em branco — o script usa DATABASE_URL como fallback.
DIRECT_URL=""

# Chave usada para assinar a sessão do painel administrativo.
# Gere uma com: openssl rand -base64 32
SESSION_SECRET=""

# Usados apenas pelo script de seed (npm run db:seed) para criar o
# primeiro usuário administrador. Se ADMIN_PASSWORD não for definida,
# uma senha aleatória é gerada e exibida no terminal (uma única vez).
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
